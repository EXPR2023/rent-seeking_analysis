# Application ports
BACKEND_PORT=8081
GATEWAY_PORT=8080
FRONTEND_PORT=5173

# AI service
AI_ENABLED=true
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
